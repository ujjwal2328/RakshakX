# ── Application ────────────────────────────────────
APP_NAME="Coal Intelligence & Reporting System"
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Server ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cirs:cirs_dev@localhost:5432/cirs_db
DATABASE_ECHO=false

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production-use-strong-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Providers (server-side only) ────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

OCR_PROVIDER=gemini
OCR_API_KEY=

# ── Storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# ── Neo4j ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this

# ── MinIO ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cirs-documents
